# =============================================
# Stripe (Cartão) + Webhook + Email (Resend)
# =============================================

# Stripe secret key
# - Teste: sk_test_...
# - Produção: sk_live_...
STRIPE_SECRET_KEY=

# Webhook secret do Stripe (Developers -> Webhooks -> seu endpoint)
STRIPE_WEBHOOK_SECRET=

# Resend (envio de email)
RESEND_API_KEY=

# Para testes (sem domínio verificado) você pode usar:
# RESEND_FROM=Sua Loja <onboarding@resend.dev>
# Em produção, use um domínio verificado no Resend, ex:
# RESEND_FROM=Cubo Criativo <vendas@seudominio.com>
RESEND_FROM=

# Para onde você quer receber os pedidos
ORDER_EMAIL_TO=


# =============================================
# Mercado Pago (Pix) + Webhook + Email (Resend)
# =============================================

# Access Token do Mercado Pago
# - Teste: APP_USR-... (gerado em "Credenciais de teste")
# - Produção: APP_USR-... (gerado em "Credenciais de produção")
MP_ACCESS_TOKEN=

# Opcional: forçar modo de teste.
# Quando MP_MODE=test, o backend força payer.email = test@testuser.com
# (algumas contas de teste bloqueiam emails reais durante o sandbox).
MP_MODE=test


# =============================================
# Supabase (Login + Banco)
# =============================================

# Frontend (Vite) — estes começam com VITE_
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend (Vercel Serverless)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
