# =============================================
# Mercado Pago (Cartão via Checkout Pro + Pix) + Webhook
# =============================================

# Access Token do Mercado Pago
# - Produção: APP_USR-...
# - Teste: dependendo da conta, pode aparecer como TEST-... ou APP_USR de teste
MP_ACCESS_TOKEN=

# URL pública do seu site (produção). Ex: https://cubo-criativo.vercel.app
# Usada para webhook e URLs de retorno do Checkout Pro.
SITE_URL=

# Opcional: usado no Pix (sandbox) para facilitar testes.
# Quando MP_MODE=test, o backend pode usar um e-mail padrão de teste.
MP_MODE=


# =============================================
# Email (Resend) — opcional (envia notificações)
# =============================================
RESEND_API_KEY=
# Para testes sem domínio verificado:
# RESEND_FROM=Sua Loja <onboarding@resend.dev>
# Em produção, use domínio verificado:
# RESEND_FROM=Cubo Criativo <vendas@seudominio.com>
RESEND_FROM=
# E-mail que recebe avisos internos de novos pedidos
ORDER_EMAIL_TO=
# E-mail exibido aos clientes para suporte
SUPPORT_EMAIL=
# Número exibido nos e-mails. Ex.: (77) 99999-9999
WHATSAPP_NUMBER=
# Nome usado no cabeçalho e assunto dos e-mails
BRAND_NAME=Cubo Criativo
# Fuso usado nas datas dos e-mails
APP_TIMEZONE=America/Bahia


# =============================================
# Supabase (Login + Banco)
# =============================================

# Frontend (Vite) — estes começam com VITE_
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend (Vercel Serverless)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# =============================================
# Rotinas automáticas
# =============================================
# Protege a rota de lembrete de Pix pendente
CRON_SECRET=
