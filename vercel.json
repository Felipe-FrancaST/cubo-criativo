{
  "rewrites": [
    {
      "source": "/p/(.*)",
      "destination": "/p/$1/index.html"
    },
    {
      "source": "/api/admin/orders",
      "destination": "/api/admin?action=orders"
    },
    {
      "source": "/api/admin/update-order",
      "destination": "/api/admin?action=update-order"
    },
    {
      "source": "/api/admin/vip-voting",
      "destination": "/api/admin?action=vip-voting"
    },
    {
      "source": "/api/create-vip-upgrade-pix-payment",
      "destination": "/api/create-pix-payment?mode=vip_upgrade"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms.html",
      "destination": "/terms.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
