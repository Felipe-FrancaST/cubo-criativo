{
  "redirects": [
    {
      "source": "/politica-de-privacidade",
      "destination": "/privacy.html",
      "permanent": true
    },
    {
      "source": "/termos",
      "destination": "/terms.html",
      "permanent": true
    },
    {
      "source": "/sob-encomenda",
      "destination": "/catalogo",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/p/(.*)",
